# Demo works without credentials. Set MOCK=0 for real research.
MOCK=1
DEMO_SCRIPT=0
# 86400 = daily; use 60 for the stage demo.
WATCH_INTERVAL_SECONDS=86400
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
PARALLEL_API_KEY=

# Optional: your own pre-connected Composio accounts.
# Only Slack Watch summaries can be posted, and only to your authenticated own DM.
COMPOSIO_API_KEY=
COMPOSIO_GMAIL_CONNECTED_ACCOUNT_ID=
COMPOSIO_SLACK_CONNECTED_ACCOUNT_ID=
COMPOSIO_TOOL_VERSION=latest
